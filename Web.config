<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Format: LocalFolder | AzureBaseUrl | AzureSasToken (optional) | NormalizeForCrystal (true/false) -->
    <add key="Source:products" value="C:\ReportImages\Products|https://yourstorageaccount.blob.core.windows.net/products|sv=2024-11-04&ss=b&srt=o&sp=r&se=2027-01-01T00:00:00Z&spr=https&sig=YOUR_SIGNATURE|true" />
    <add key="Source:logos" value="C:\ReportImages\Logos|https://yourstorageaccount.blob.core.windows.net/company-logos||true" />
  </appSettings>

  <system.web>
    <compilation targetFramework="4.8" debug="true" />
    <httpRuntime targetFramework="4.8" />
    <pages controlRenderingCompatibilityVersion="4.0" />
  </system.web>

  <system.webServer>
    <handlers>
      <!--
        Maps any two-segment path (key/filename) to the image proxy handler.
        Example clean URLs:
          /products/logo.png
          /logos/company.png
      -->
      <add name="CleanImageProxyRoute"
           path="*/*"
           verb="GET"
           type="CrystalImageHelper.ImageProxyHandler"
           resourceType="Unspecified"
           preCondition="integratedMode" />
    </handlers>
  </system.webServer>
</configuration>
